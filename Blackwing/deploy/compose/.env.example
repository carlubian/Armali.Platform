# Blackwing Compose configuration example.
#
# Copy to ".env" in this directory for local container execution:
#   cp .env.example .env
# The real ".env" is untracked and must never contain committed secrets.
#
# In production these values are supplied by Portainer as stack environment
# variables rather than a committed file.

# ---------------------------------------------------------------------------
# Ingress
# ---------------------------------------------------------------------------
# Host port published by Caddy. Clients reach Blackwing at http://<server>:<port>/.
# 5526 is Blackwing's number in the monorepo; it is also the UID:GID of the
# non-root user inside the backend container.
BLACKWING_HTTP_PORT=5526

# ---------------------------------------------------------------------------
# Persistent host storage (production / full local stack)
# ---------------------------------------------------------------------------
# Root host path for the images and Data Protection key bind mounts. The
# subdirectories must exist and be owned by UID:GID 5526:5526 before the stack
# starts. Backups of these volumes are the responsibility of a separate
# application, not of Blackwing.
BLACKWING_DATA_PATH=/data/volumes/blackwing

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
BLACKWING_POSTGRES_DB=blackwing
BLACKWING_POSTGRES_USER=blackwing
# REQUIRED. Use a strong, unique value. Secret: never commit a real value.
# The placeholder below only exists so `docker compose config` can validate the
# stack in CI; scripts/compose-up.ps1 replaces it when it creates a local .env.
BLACKWING_POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# First administrator (first start only)
# ---------------------------------------------------------------------------
# Needed only the first time the stack runs against an empty database: the seed
# creates this account as an Admin and then does nothing on every later start.
# Both values are secret and both must be set together - configuring only one of
# them fails the backend at start, on purpose, so a typo cannot leave the
# deployment with no way in. There is no default: a committed one would be a
# publicly known administrator account.
BLACKWING_BOOTSTRAP_USERNAME=
BLACKWING_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Optional Seq log delivery
# ---------------------------------------------------------------------------
BLACKWING_SEQ_ENABLED=false
BLACKWING_SEQ_SERVERURL=
# Secret: never commit a real value.
BLACKWING_SEQ_APIKEY=

# ---------------------------------------------------------------------------
# Images (production pulls immutable commit-SHA tags from the private registry)
# ---------------------------------------------------------------------------
# Local builds default to ":local"; production overrides these with registry tags.
BLACKWING_BACKEND_IMAGE=blackwing-backend:local
BLACKWING_CADDY_IMAGE=blackwing-caddy:local
BLACKWING_FRONTEND_IMAGE=blackwing-frontend:local
# Public build-time release identifier used by frontend diagnostics.
BLACKWING_FRONTEND_VERSION=local

# ASP.NET Core environment for the backend container.
ASPNETCORE_ENVIRONMENT=Production

# ---------------------------------------------------------------------------
# Infrastructure-only dev stack (docker-compose.infra.yml)
# ---------------------------------------------------------------------------
BLACKWING_POSTGRES_PORT=5432
BLACKWING_SEQ_UI_PORT=5341
