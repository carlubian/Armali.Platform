<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      One generator of test images for both test projects, so the pixel and EXIF assembly logic
      exists once. It is linked rather than copied: the file's home is the integration project.
    -->
    <Compile Include="..\Blackwing.Api.IntegrationTests\Images\TestImages.cs" Link="Images\TestImages.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\backend\Blackwing.Api\Blackwing.Api.csproj" />
    <ProjectReference Include="..\..\..\src\backend\Blackwing.Persistence\Blackwing.Persistence.csproj" />
    <ProjectReference Include="..\..\..\src\backend\Blackwing.Shared\Blackwing.Shared.csproj" />
  </ItemGroup>

</Project>
