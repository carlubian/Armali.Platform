<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blackwing.Persistence\Blackwing.Persistence.csproj" />
    <ProjectReference Include="..\Blackwing.Shared\Blackwing.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!--
      Design-time tooling for `dotnet ef`. Migrations live in Blackwing.Persistence, but they are
      generated with this project as the startup project (only here is the identity model
      contributor registered), and the EF tools require the Design package in the startup project
      as well as in the target one. Its assets stay private, so nothing design-time leaks into
      the published output or into anything that references this project.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <!--
      Image processing. SkiaSharp (MIT) decodes, rotates, resizes and encodes WebP;
      MetadataExtractor (Apache 2.0) reads EXIF. The NoDependencies native assets keep the runtime
      image free of libfontconfig, which Blackwing never needs because it never draws text. Both
      libraries stay confined to this project: an architecture test fails if Blackwing.Shared or
      Blackwing.Persistence ever reference them.
    -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blackwing.UnitTests" />
    <InternalsVisibleTo Include="Blackwing.Api.IntegrationTests" />
  </ItemGroup>

</Project>
