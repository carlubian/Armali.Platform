{
  "ConnectionStrings": {
    "Blackwing": "Host=localhost;Port=5432;Database=blackwing;Username=blackwing;Password=blackwing"
  },
  "Blackwing": {
    "Storage": {
      "ImagesPath": "images.local",
      "DataProtectionKeysPath": ""
    },
    "Observability": {
      "Seq": { "Enabled": false, "ServerUrl": "", "ApiKey": "", "MinimumLevel": "Information" }
    },
    // First-administrator bootstrap. Only needed on a first start against an empty database;
    // the seed is idempotent and does nothing once the account exists. Both values are secret
    // and are never versioned with content: supply them through user secrets or environment
    // variables. Configuring only one of the two fails the host at start, on purpose.
    "Identity": {
      "Bootstrap": { "UserName": "", "Password": "" }
    }
  },
  "AllowedHosts": "*",
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
